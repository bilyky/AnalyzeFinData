# Copy this file to .env and fill in real values. .env is gitignored.

# Chaikin Analytics member ID (numeric, from your account URL)
CHAIKIN_UID=

# Chaikin Analytics app-level API key
CHAIKIN_API_KEY=

# Optional: parallel worker count for the screener (default 10)
# CHAIKIN_WORKERS=10

# RapidAPI key for OHLCV price history backfill
# RAPIDAPI_KEY=

# Set to 1 to run live broker/API tests in the test suite
# AETHER_LIVE_TESTS=
