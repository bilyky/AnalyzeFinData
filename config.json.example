{
  "chaikin": {
    "email": "your_chaikin_email@example.com",
    "password": "your_chaikin_password",
    "uid": "your_chaikin_uid_here",
    "api_key": ""
  },
  "etrade": {
    "username": "your_etrade_username",
    "password": "your_etrade_password",
    "proxy": "",
    "sandbox": {
      "consumer_key": "your_sandbox_consumer_key",
      "consumer_secret": "your_sandbox_consumer_secret"
    },
    "production": {
      "consumer_key": "your_production_consumer_key",
      "consumer_secret": "your_production_consumer_secret"
    }
  },
  "rapidapi": {
    "api_key": "your_rapidapi_key_here"
  },
  "email_intel": {
    "mailboxes": [
      {
        "email": "primary_newsletters@example.com",
        "password_env": "SMTP_PASSWORD",
        "imap_server": "imap.gmail.com"
      },
      {
        "email": "secondary_alerts@example.com",
        "password_env": "SMTP_PASSWORD_ALT",
        "imap_server": "imap.gmail.com"
      }
    ]
  },
  "email_sender": {
    "address": "your_sender@example.com",
    "recipient": "your_recipient@example.com",
    "password": "your_gmail_app_password_here"
  },
  "database": {
    "_note": "Legacy PostgreSQL connector (database.py). Leave url empty if unused.",
    "url": ""
  },
  "accounts": {
    "real": ["XXXX", "YYYY"]
  },
  "ai": {
    "_note": "GitHub Models (the old free 'github_gpt' provider on models.inference.ai.azure.com) was RETIRED on 2026-07-30 and removed here. Pick any provider below as `primary`.",
    "primary": "gemini_oai",
    "max_intel_emails": 20,
    "providers": {

      "gemini_oai": {
        "_note": "Free tier via Google AI Studio — aistudio.google.com. Get GEMINI_API_KEY there (no credit card). Uses OpenAI-compatible REST so no extra dependencies.",
        "enabled": true,
        "type": "openai_compatible",
        "model": "gemini-2.5-flash",
        "endpoint": "https://generativelanguage.googleapis.com/v1beta/openai/chat/completions",
        "api_key_source": "env:GEMINI_API_KEY"
      },
      "openrouter": {
        "_note": "OpenRouter (free route) — sign up at openrouter.ai (no credit card), create a key, set OPENROUTER_API_KEY. Free models rotate in/out and rate-limit (429), so check openrouter.ai/models for a current ':free' model. DeepSeek's :free variant is often OUT of rotation; for real DeepSeek top up credits and use model 'deepseek/deepseek-chat'.",
        "enabled": false,
        "type": "openai_compatible",
        "model": "poolside/laguna-s-2.1:free",
        "endpoint": "https://openrouter.ai/api/v1/chat/completions",
        "api_key_source": "env:OPENROUTER_API_KEY"
      },
      "claude": {
        "_note": "Anthropic API — console.anthropic.com. Set ANTHROPIC_API_KEY env var.",
        "enabled": false,
        "type": "anthropic",
        "model": "claude-opus-4-8",
        "api_key_source": "env:ANTHROPIC_API_KEY"
      },
      "gemini_cli": {
        "_note": "Gemini via the gemini CLI binary (gemini.google.com/app — install gemini CLI). No API key needed but requires the CLI installed.",
        "enabled": false,
        "type": "gemini_cli",
        "model": "gemini-2.5-flash"
      }
    }
  },
  "web": {
    "port": 8888,
    "host": "0.0.0.0",
    "secret": "long_random_string_for_signing_session_tokens",
    "admins": [
      { "user": "admin", "pass": "change_me" }
    ]
  },
  "oracle": {
    "account_id": "0053",
    "start_equity": 22978.72,
    "target_date": "2026-12-31",
    "s10_floor": 2.5,
    "bubble_limit": 2.5,
    "min_rr_ratio": 1.5,
    "decay_limit": -2.0
  }
}
